<script>
  // 产品页 Description / Technical Parameters 标签切换
  document.querySelectorAll<HTMLElement>("[data-product-tabs]").forEach((tabBar) => {
    const tabs = tabBar.querySelectorAll<HTMLButtonElement>(".product-tab");
    const panels = tabBar.parentElement?.querySelectorAll<HTMLElement>("[data-tab-panel]");
    if (!tabs.length || !panels?.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        tabs.forEach((btn) => {
          const isActive = btn === tab;
          btn.classList.toggle("bg-white", isActive);
          btn.classList.toggle("font-bold", isActive);
          btn.classList.toggle("text-neutral-950", isActive);
          btn.classList.toggle("bg-neutral-120", !isActive);
          btn.classList.toggle("text-neutral-600", !isActive);
        });
        panels.forEach((panel) => {
          panel.classList.toggle("hidden", panel.dataset.tabPanel !== target);
        });
      });
    });
  });

  // 产品页缩略图切换主图
  document.querySelectorAll("[data-product-thumb]").forEach((thumb) => {
    thumb.addEventListener("click", () => {
      const mainImg = document.querySelector<HTMLImageElement>("[data-product-main-img]");
      if (!mainImg) return;
      mainImg.src = (thumb as HTMLElement).dataset.productThumb || mainImg.src;
      mainImg.parentElement?.querySelectorAll("[data-product-thumb]").forEach((btn) => {
        btn.setAttribute("aria-pressed", btn === thumb ? "true" : "false");
      });
    });
  });

  // News 页面分页（每页12条，4列×3行）
  (function() {
    const items = document.querySelectorAll<HTMLElement>("[data-news-page]");
    if (!items.length) return;
    const perPage = 12;
    const totalPages = Math.ceil(items.length / perPage);
    const pagination = document.getElementById("news-pagination");
    if (!pagination) return;

    function showPage(page: number) {
      items.forEach((el) => {
        el.classList.toggle("hidden", el.dataset.newsPage !== String(page));
      });
      pagination!.querySelectorAll("button").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.page === String(page);
        btn.classList.toggle("bg-brand-primary", isActive);
        btn.classList.toggle("text-white", isActive);
        btn.classList.toggle("border-brand-primary", isActive);
        btn.classList.toggle("border-neutral-380", !isActive);
        btn.classList.toggle("text-neutral-600", !isActive);
      });
    }

    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement("button");
      btn.textContent = String(i);
      btn.dataset.page = String(i);
      btn.className = "h-[38px] w-[38px] border text-[14px] transition hover:border-brand-primary";
      if (i === 1) {
        btn.classList.add("bg-brand-primary", "text-white", "border-brand-primary");
      } else {
        btn.classList.add("border-neutral-380", "text-neutral-600");
      }
      btn.addEventListener("click", () => showPage(i));
      pagination.appendChild(btn);
    }
  })();
</script>
