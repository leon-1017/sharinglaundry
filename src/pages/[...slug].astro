---
import MainLayout from "../layouts/MainLayout.astro";
import AboutUs from "../components/AboutUs.astro";
import EntryGrid from "../components/EntryGrid.astro";
import EntryCard from "../components/EntryCard.astro";
import ProductGrid from "../components/ProductGrid.astro";
import {
  formatDate,
  getEntries,
  getProductCategory,
  getProductCollection,
  getProductsForCategory,
  getRelatedEntries,
} from "../lib/site";

export function getStaticPaths() {
  return getEntries()
    .filter((entry) => entry.path !== "/")
    .map((entry) => ({
      params: {
        slug: entry.path.replace(/^\/|\/$/g, ""),
      },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const allProducts = getProductCollection();
const isProduct = entry.kind === "product";
const isContact = entry.path === "/contact-us/";
const isRefund = entry.path === "/refund-and-returns-policy/";
const isAboutUs = entry.path === "/about-us/";
const isSupport = entry.path === "/support/";
const isApplication = entry.path === "/application/";
const isAppSub = entry.path.startsWith("/application/") && entry.path !== "/application/";
const isNews = entry.path === "/news/";
const isNewsPost = entry.kind === "post";

// Application 子页面：从 contentHtml 提取图片、描述、方案
let appImage = "";
let appDescription = "";
let appSolutionsLeft = "";
let appSolutionsRight = "";
if (isAppSub && entry.contentHtml) {
  const imgMatch = entry.contentHtml.match(/src="([^"]+)"/);
  appImage = imgMatch ? imgMatch[1] : "";
  const descMatch = entry.contentHtml.match(/<\/figure>\s*<p>(.*?)<\/p>/s);
  appDescription = descMatch ? descMatch[1] : "";
  // 提取描述段落之后到 HOTLINE 之前的所有方案内容（含多个 h3/p 段落）
  const solutionsMatch = entry.contentHtml.match(/<\/p>\s*([\s\S]*?)<h6>HOTLINE/);
  const rawSolutions = solutionsMatch ? solutionsMatch[1].trim() : "";
  // 按 h3 拆分为多个块，左右分列
  const blocks = rawSolutions.split(/(?=<h3>)/);
  const leftBlocks: string[] = [];
  const rightBlocks: string[] = [];
  blocks.forEach((block, i) => {
    const trimmed = block.trim();
    if (!trimmed) return;
    if (i % 2 === 0) {
      leftBlocks.push(trimmed);
    } else {
      rightBlocks.push(trimmed);
    }
  });
  appSolutionsLeft = leftBlocks.join("");
  appSolutionsRight = rightBlocks.join("");
}

// 页面 hero 背景图映射
const heroBgMap: Record<string, string> = {
  "/about-us/": "/wp-assets/uploads/img-bg-laundry.jpg",
  "/products/": "/wp-assets/uploads/img-bg-laundry.jpg",
  "/news/": "/wp-assets/uploads/img-newsbanner.jpg",
  "/support/": "/wp-assets/uploads/img-banner-support.jpg",
  "/application/": "/wp-assets/uploads/img-bg-laundry.jpg",
};
const heroBg = heroBgMap[entry.path] || (entry.path.startsWith("/products/") || entry.path.startsWith("/product/") || entry.path.startsWith("/application/") ? "/wp-assets/uploads/img-bg-laundry.jpg" : entry.kind === "post" ? "/wp-assets/uploads/img-newsbanner.jpg" : null);

const isListing =
  entry.kind === "productCategory" ||
  entry.kind === "category" ||
  entry.path === "/products/" ||
  entry.path === "/shop/" ||
  entry.path === "/news/" ||
  (entry.path.startsWith("/products/") && entry.path !== "/products/");

// 列表页使用 entry.listingProducts（真实数据）;否则按类型推断
const listingProducts =
  entry.listingProducts && entry.listingProducts.length > 0
    ? entry.listingProducts
    : null;
const listingEntries =
  listingProducts
    ? [] // 产品卡由 ProductGrid 渲染
    : entry.path === "/products/" || entry.path === "/shop/"
      ? allProducts
      : entry.path === "/news/" || entry.kind === "category"
        ? getEntries().filter((item) => item.kind === "post")
        : entry.kind === "productCategory"
          ? getProductsForCategory(entry.path)
          : getRelatedEntries(entry);
const related = getRelatedEntries(entry);
const productCategory = isProduct ? getProductCategory(entry) : null;
const productImages = [...new Set([entry.image, ...entry.images].filter(Boolean))];

const siteUrl = Astro.site?.toString() || "https://www.sharinglaundry.com";
function absoluteUrl(path: string) {
  return new URL(path, siteUrl).toString();
}

// JSON-LD schemas
const breadcrumbItems: Array<{ name: string; item: string }> = [{ name: "Home", item: absoluteUrl("/") }];
if (isProduct && productCategory) {
  breadcrumbItems.push({ name: productCategory.label, item: absoluteUrl(productCategory.href) });
  breadcrumbItems.push({ name: entry.title, item: absoluteUrl(entry.path) });
} else if (entry.kind === "post") {
  breadcrumbItems.push({ name: "News", item: absoluteUrl("/news/") });
  breadcrumbItems.push({ name: entry.title, item: absoluteUrl(entry.path) });
} else if (entry.path !== "/") {
  breadcrumbItems.push({ name: entry.title, item: absoluteUrl(entry.path) });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.item,
  })),
};

const schemas: Array<Record<string, unknown>> = [breadcrumbSchema];

if (isProduct) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Product",
    name: entry.title,
    image: productImages.map((img) => absoluteUrl(img)),
    description: entry.description,
    brand: {
      "@type": "Brand",
      name: "Wuxi Sharing Machinery Co.,Ltd",
    },
    url: absoluteUrl(entry.path),
  });
} else if (entry.kind === "post") {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: entry.title,
    description: entry.description,
    image: entry.image ? absoluteUrl(entry.image) : undefined,
    datePublished: entry.datePublished,
    dateModified: entry.dateModified || entry.datePublished,
    author: {
      "@type": "Organization",
      name: "Wuxi Sharing Machinery Co.,Ltd",
    },
    publisher: {
      "@type": "Organization",
      name: "Wuxi Sharing Machinery Co.,Ltd",
      logo: {
        "@type": "ImageObject",
        url: absoluteUrl("/wp-assets/uploads/250X100.png"),
      },
    },
    url: absoluteUrl(entry.path),
  });
}

// 为重复路径提供 canonical(主要路径)
const canonicalHref =
  entry.path.startsWith("/products/") && entry.path !== "/products/"
    ? entry.path.replace("/products/", "/product-category/") +
      (entry.path === "/products/" ? "" : "")
    : entry.path === "/shop/"
      ? "/products/"
      : null;
---

<MainLayout title={`${entry.title} - Wuxi Sharing Machinery Co.,Ltd`} description={entry.description} image={entry.image} canonical={canonicalHref || undefined} schemas={schemas}>
  {
    isProduct ? (
      <main class="pb-[60px]">
        {heroBg ? (
          <section class="relative overflow-hidden bg-cover bg-center bg-no-repeat py-[90px] text-white" style={`background-image: url('${heroBg}');`} data-reveal="fade">
            <div class="absolute inset-0 bg-bg-hero-overlay"></div>
            <div class="pixel-container relative z-10">
              <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
              <div class="mt-[18px] h-[2px] w-[64px] bg-brand-primary"></div>
              <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
                Focus on Industrial and Commercial Laundry Equipment over 15 years
              </p>
            </div>
          </section>
        ) : null}
        <nav class="pixel-container py-[18px] text-[14px] text-neutral-600">
          <a href="/" class="hover:text-brand-primary">Home</a>
          <span class="px-2">/</span>
          <a href={productCategory?.href} class="hover:text-brand-primary">{productCategory?.label}</a>
          <span class="px-2">/</span>
          <span>{entry.title}</span>
        </nav>

        <section class="pixel-container grid gap-[48px] py-[28px] md:grid-cols-[520px_1fr]" data-reveal="fade-up">
          <div>
            <div class="border border-neutral-320 bg-white p-[12px]">
              {entry.image ? (
                <img src={entry.image} alt={entry.title} class="aspect-square w-full object-cover" data-product-main-img />
              ) : (
                <div class="aspect-square bg-neutral-160" />
              )}
            </div>
            <div class="mt-[15px] flex gap-[12px]">
              {productImages.slice(0, 3).map((image, idx) => (
                <button type="button" class="h-[82px] w-[82px] border border-neutral-380 p-[4px] transition hover:border-brand-primary aria-pressed:border-brand-primary" data-product-thumb={image} aria-pressed={idx === 0 ? "true" : "false"}>
                  <img src={image} alt={entry.title} class="h-full w-full object-cover" />
                </button>
              ))}
            </div>
          </div>

          <div class="pt-[10px]">
            <h2 class="text-[31px] font-normal leading-tight text-text-heading">{entry.title}</h2>
            <div class="my-[26px] h-px bg-neutral-320"></div>
            <p class="text-[15px] leading-[1.7] text-neutral-600">{entry.description}</p>
            <div class="mt-[22px] text-[14px] text-neutral-600">
              <span>Category: </span>
              <a href={productCategory?.href} class="text-brand-primary">{productCategory?.label}</a>
            </div>
            <a href="/contact-us/" class="btn-primary mt-[30px]">Request an Offer</a>
          </div>
        </section>

        <section class="pixel-container pt-[28px]" data-reveal="fade-up" data-reveal-delay="100">
          <div class="border-b border-neutral-390" data-product-tabs>
            <button
              type="button"
              data-tab="description"
              class="product-tab border border-b-0 border-neutral-390 bg-white px-[22px] py-[12px] text-[14px] font-bold text-neutral-950"
            >
              Description
            </button>
            {entry.techTableHtml ? (
              <button
                type="button"
                data-tab="parameters"
                class="product-tab ml-[4px] border border-b-0 border-neutral-390 bg-neutral-120 px-[22px] py-[12px] text-[14px] text-neutral-600"
              >
                Technical Parameters
              </button>
            ) : null}
          </div>
          <article
            data-tab-panel="description"
            class="content-prose border border-t-0 border-neutral-390 px-[28px] py-[26px]"
            set:html={entry.contentHtml}
          />
          {entry.techTableHtml ? (
            <article
              data-tab-panel="parameters"
              class="content-prose hidden border border-t-0 border-neutral-390 px-[28px] py-[26px]"
              set:html={entry.techTableHtml}
            />
          ) : null}
        </section>

        <section class="pixel-container pt-[54px]" data-reveal="fade-up">
          <h2 class="site-section-title mb-[26px]">Related products</h2>
          <div class="grid gap-[28px] sm:grid-cols-2 lg:grid-cols-4">
            {related.slice(0, 4).map((item) => (
              <a href={item.path} class="block text-center">
                <div class="aspect-square border border-neutral-320 bg-neutral-130">
                  {item.image ? <img src={item.image} alt={item.title} class="h-full w-full object-cover" /> : null}
                </div>
                <h3 class="mt-[14px] text-[14px] font-bold text-brand-primary-hover">{item.title}</h3>
              </a>
            ))}
          </div>
        </section>
      </main>
    ) : isContact ? (
      <main>
        <section class="relative overflow-hidden bg-navy-900 py-[110px] text-white" data-reveal="fade">
          {entry.image ? (
            <img src={entry.image} alt={entry.title} class="absolute inset-0 h-full w-full object-cover opacity-60" />
          ) : null}
          <div class="pixel-container relative">
            <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
            <div class="mt-[18px] h-[2px] w-[64px] bg-brand-primary"></div>
            <p class="mt-[24px] max-w-[720px] text-[15px] leading-[1.7] text-white/85">
              Welcome to our contact page! We're glad that you're interested in getting in touch with us. Whether you have a question, a suggestion, or just want to say hello, we're here to listen.
            </p>
          </div>
        </section>
        <section class="section-md bg-white" data-reveal="fade-up">
          <div class="pixel-container">
            <h2 class="site-section-title">Contact us</h2>
            <div class="mt-[40px] grid gap-[30px] md:grid-cols-3">
              <div class="group rounded-lg border border-neutral-380 bg-white p-[30px] shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(7,53,107,0.15)]">
                <div class="flex h-[48px] w-[48px] items-center justify-center rounded-lg bg-brand-primary text-white transition-transform duration-300 group-hover:scale-110">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <h3 class="mt-[20px] text-[18px] font-bold text-text-heading">Address</h3>
                <p class="mt-[12px] text-[15px] leading-[1.7] text-neutral-600">No.588, Nanhu Avenue, Wuxi City, China</p>
              </div>
              <div class="group rounded-lg border border-neutral-380 bg-white p-[30px] shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(7,53,107,0.15)]">
                <div class="flex h-[48px] w-[48px] items-center justify-center rounded-lg bg-brand-primary text-white transition-transform duration-300 group-hover:scale-110">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <h3 class="mt-[20px] text-[18px] font-bold text-text-heading">Phone</h3>
                <p class="mt-[12px] text-[15px] leading-[1.7] text-neutral-600"><a href="tel:+8651066206136" class="hover:text-brand-primary transition-colors">+86-51066206136</a></p>
                <p class="text-[15px] leading-[1.7] text-neutral-600"><a href="tel:+8613606196136" class="hover:text-brand-primary transition-colors">+86-13606196136</a></p>
              </div>
              <div class="group rounded-lg border border-neutral-380 bg-white p-[30px] shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(7,53,107,0.15)]">
                <div class="flex h-[48px] w-[48px] items-center justify-center rounded-lg bg-brand-primary text-white transition-transform duration-300 group-hover:scale-110">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <h3 class="mt-[20px] text-[18px] font-bold text-text-heading">Email</h3>
                <p class="mt-[12px] text-[15px] leading-[1.7] text-neutral-600"><a href="mailto:info@sharinglaundry.com" class="hover:text-brand-primary transition-colors">i<span>n</span><span>fo</span>@sharinglaundry.com</a></p>
              </div>
            </div>
          </div>
          <div class="pixel-container mt-[60px]">
            <iframe src="https://www.google.com/maps?q=No.588+Nanhu+Avenue+Wuxi+City+China&output=embed" width="100%" height="400" class="rounded-lg" style="border:0;" allowfullscreen loading="lazy"></iframe>
          </div>
        </section>
      </main>
    ) : isAboutUs ? (
      <AboutUs entry={entry} />
    ) : isListing ? (
      <main class="bg-white">
        {heroBg ? (
          <section class="relative overflow-hidden bg-cover bg-center bg-no-repeat py-[90px] text-white" style={`background-image: url('${heroBg}');`} data-reveal="fade">
            <div class="absolute inset-0 bg-bg-hero-overlay"></div>
            <div class="pixel-container relative z-10">
              <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
              <div class="mt-[18px] h-[2px] w-[64px] bg-brand-primary"></div>
              {entry.path.startsWith("/products/") ? (
                <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
                  Focus on Industrial and Commercial Laundry Equipment over 15 years
                </p>
              ) : null}
            </div>
          </section>
        ) : null}
        <section class="section-md bg-white" data-reveal="fade-up">
          <div class="pixel-container">
            {listingProducts ? (
              <ProductGrid
                products={listingProducts}
              />
            ) : isNews ? (
              <>
                <div id="news-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                  {listingEntries.map((item, idx) => (
                    <div data-news-page={Math.floor(idx / 12) + 1} class:list={[idx >= 12 ? "hidden" : ""]}>
                      <EntryCard entry={item} />
                    </div>
                  ))}
                </div>
                {listingEntries.length > 12 ? (
                  <div id="news-pagination" class="mt-[40px] flex justify-center gap-[8px]"></div>
                ) : null}
              </>
            ) : (
              <EntryGrid
                title="Products"
                entries={listingEntries}
              />
            )}
          </div>
        </section>
      </main>
    ) : (
      <main>
        {heroBg ? (
          <section class="relative overflow-hidden bg-cover bg-center bg-no-repeat py-[90px] text-white" style={`background-image: url('${heroBg}');`} data-reveal="fade">
            <div class="absolute inset-0 bg-bg-hero-overlay"></div>
            <div class="pixel-container relative z-10">
              <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
              <div class="mt-[18px] h-[2px] w-[64px] bg-brand-primary"></div>
              {isNewsPost ? (
                <nav class="mt-[16px] text-[14px] text-white/80">
                  <a href="/" class="hover:text-white">Home</a>
                  <span class="px-2">/</span>
                  <a href="/news/" class="hover:text-white">News</a>
                  <span class="px-2">/</span>
                  <span>{entry.title}</span>
                </nav>
              ) : null}
              {isSupport ? (
                <div class="mt-[20px] max-w-[640px]">
                  <p class="text-[22px] font-bold leading-snug text-white md:text-[26px]">We are here with you every step of the way</p>
                  <p class="mt-[14px] text-[16px] leading-[1.7] text-white/85">Sharing's customer service support including pre-sales and after-sales service support, made up by experienced technical staff, is able to assist every customer with detailed requirements or problems.</p>
                </div>
              ) : null}
              {isApplication ? (
                <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
                  Revolutionizing industrial and commercial laundry equipment applications
                </p>
              ) : null}
              {isAppSub ? (
                <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
                  Revolutionizing industrial and commercial laundry equipment applications
                </p>
              ) : null}
            </div>
          </section>
        ) : null}
        {!isApplication && !isAppSub ? (
        <section class="section-md pixel-container" data-reveal="fade-up">
          {!heroBg ? <h1 class="site-section-title">{entry.title}</h1> : null}
          {!isSupport && entry.datePublished ? <p class="mt-[22px] text-[14px] text-neutral-600">{formatDate(entry.datePublished)}</p> : null}
          {!isSupport && !isNewsPost && entry.image && !entry.imageBoxCards?.length ? (
            <img src={entry.image} alt={entry.title} class="mt-[34px] max-h-[520px] w-full object-cover" />
          ) : null}
          <article class:list={["content-prose", !heroBg ? "mt-[34px]" : ""]}>
            {isSupport ? (
              <>
                <h2 class="text-[20px] font-bold text-brand-primary-hover">Pre-Sales Service Support</h2>
                <p class="mt-[16px] text-[15px] leading-[1.7] text-neutral-600">Sharing's Pre-sales service support department will work directly with you to determine your needs, knowing that the correct type and degree of agitation is a crucial factor in almost every processing operation.</p>
                <p class="mt-[14px] text-[15px] leading-[1.7] text-neutral-600">These close customer relationships ensure that our products are manufactured to meet exact requirements for each specific application.</p>
                <p class="mt-[14px] text-[15px] leading-[1.7] text-neutral-600">Engineering staff take into consideration the capacity, size and budgets, etc. Then they select from a vast range of options to provide the best choice in solutions for the application type and the size of the agitating unit required for the job.</p>

                <div class="mt-[30px] grid gap-[16px] sm:grid-cols-2">
                  <div class="overflow-hidden">
                    <img src="/wp-assets/uploads/img-support-01.jpeg" alt="Pre-sales service support" class="h-full w-full object-cover" loading="lazy" />
                  </div>
                  <div class="overflow-hidden">
                    <img src="/wp-assets/uploads/img-support-02.jpg" alt="Pre-sales consultation" class="h-full w-full object-cover" loading="lazy" />
                  </div>
                </div>

                <h2 class="mb-[16px] mt-[40px] text-[20px] font-bold text-brand-primary-hover">After-Sales Service Support</h2>
                <p class="text-[15px] leading-[1.7] text-neutral-600">Sharing's After-sales service support department will provide the following services:</p>
                <ol class="mt-[14px] list-decimal space-y-[10px] pl-[20px] text-[15px] leading-[1.7] text-neutral-600">
                  <li>Spare parts for every piece of equipment with interchangeability guarantee and best delivery time.</li>
                  <li>Technical assistance or supervision on-site during the installation, maintenance, commissioning and start-up phases.</li>
                  <li>Customized maintenance programs (Periodic or as-required maintenance, during and after the warranty period).</li>
                  <li>Each service task is documented in our equipment records. This way the current condition and life cycle can always be displayed and analyzed. This service is free of charge for the owner of a Sharing's laundry equipment.</li>
                </ol>
              </>
            ) : (
              <div set:html={entry.fallbackContent || entry.contentHtml}></div>
            )}
          </article>
          {isRefund ? <a href="/contact-us/" class="btn-primary mt-[30px]">Contact Sales</a> : null}
        </section>
        ) : null}

        {isAppSub ? (
          <section class="section-md pixel-container" data-reveal="fade-up">
            <div class="grid gap-[48px] md:grid-cols-[1fr_1fr]">
              <div>
                {appImage ? (
                  <img src={appImage} alt={entry.title} class="w-full object-cover" loading="lazy" />
                ) : null}
              </div>
              <div>
                {appDescription ? (
                  <p class="text-[15px] leading-[1.7] text-neutral-600" set:html={appDescription} />
                ) : null}
              </div>
            </div>
            <div class="mt-[48px] grid gap-[48px] md:grid-cols-[1fr_1fr]">
              {appSolutionsLeft ? (
                <div class="app-solutions" set:html={appSolutionsLeft} />
              ) : null}
              {appSolutionsRight ? (
                <div class="app-solutions" set:html={appSolutionsRight} />
              ) : null}
            </div>
          </section>
          <section class="section-md slanted-bg bg-white text-center" data-reveal="fade-up">
            <div class="pixel-container">
              <div class="text-[13px] font-bold uppercase tracking-[0.22em] text-brand-primary">HOTLINE 24/7</div>
