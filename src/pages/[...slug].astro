---
import MainLayout from "../layouts/MainLayout.astro";
import AboutUs from "../components/AboutUs.astro";
import InquiryForm from "../components/InquiryForm.astro";
import EntryGrid from "../components/EntryGrid.astro";
import EntryCard from "../components/EntryCard.astro";
import ProductGrid from "../components/ProductGrid.astro";
import {
  formatDate,
  getEntries,
  getProductCategory,
  getProductCollection,
  getProductsForCategory,
  getRelatedEntries,
} from "../lib/site";

export function getStaticPaths() {
  return getEntries()
    .filter((entry) => entry.path !== "/")
    .map((entry) => ({
      params: {
        slug: entry.path.replace(/^\/|\/$/g, ""),
      },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const allProducts = getProductCollection();
const isProduct = entry.kind === "product";
const isContact = entry.path === "/contact-us/";
const isRefund = entry.path === "/refund-and-returns-policy/";
const isAboutUs = entry.path === "/about-us/";
const isSupport = entry.path === "/support/";
const isApplication = entry.path === "/application/";
const isAppSub = entry.path.startsWith("/application/") && entry.path !== "/application/";
const isNews = entry.path === "/news/";

// Application 子页面：从 contentHtml 提取图片、描述、方案
let appImage = "";
let appDescription = "";
let appSolutionsLeft = "";
let appSolutionsRight = "";
if (isAppSub && entry.contentHtml) {
  const imgMatch = entry.contentHtml.match(/src="([^"]+)"/);
  appImage = imgMatch ? imgMatch[1] : "";
  const descMatch = entry.contentHtml.match(/<\/figure>\s*<p>(.*?)<\/p>/s);
  appDescription = descMatch ? descMatch[1] : "";
  // 提取描述段落之后到 HOTLINE 之前的所有方案内容（含多个 h3/p 段落）
  const solutionsMatch = entry.contentHtml.match(/<\/p>\s*([\s\S]*?)<h6>HOTLINE/);
  const rawSolutions = solutionsMatch ? solutionsMatch[1].trim() : "";
  // 按 h3 拆分为多个块，左右分列
  const blocks = rawSolutions.split(/(?=<h3>)/);
  const leftBlocks: string[] = [];
  const rightBlocks: string[] = [];
  blocks.forEach((block, i) => {
    const trimmed = block.trim();
    if (!trimmed) return;
    if (i % 2 === 0) {
      leftBlocks.push(trimmed);
    } else {
      rightBlocks.push(trimmed);
    }
  });
  appSolutionsLeft = leftBlocks.join("");
  appSolutionsRight = rightBlocks.join("");
}

// 页面 hero 背景图映射
const heroBgMap: Record<string, string> = {
  "/about-us/": "/wp-assets/uploads/img-bg-laundry.jpg",
  "/products/": "/wp-assets/uploads/img-bg-laundry.jpg",
  "/news/": "/wp-assets/uploads/img-newsbanner.jpg",
  "/support/": "/wp-assets/uploads/img-banner-support.jpg",
  "/application/": "/wp-assets/uploads/img-bg-laundry.jpg",
};
const heroBg = heroBgMap[entry.path] || (entry.path.startsWith("/products/") || entry.path.startsWith("/product/") || entry.path.startsWith("/application/") ? "/wp-assets/uploads/img-bg-laundry.jpg" : null);

const isListing =
  entry.kind === "productCategory" ||
  entry.kind === "category" ||
  entry.path === "/products/" ||
  entry.path === "/shop/" ||
  entry.path === "/news/" ||
  (entry.path.startsWith("/products/") && entry.path !== "/products/");

// 列表页使用 entry.listingProducts（真实数据）;否则按类型推断
const listingProducts =
  entry.listingProducts && entry.listingProducts.length > 0
    ? entry.listingProducts
    : null;
const listingEntries =
  listingProducts
    ? [] // 产品卡由 ProductGrid 渲染
    : entry.path === "/products/" || entry.path === "/shop/"
      ? allProducts
      : entry.path === "/news/" || entry.kind === "category"
        ? getEntries().filter((item) => item.kind === "post")
        : entry.kind === "productCategory"
          ? getProductsForCategory(entry.path)
          : getRelatedEntries(entry);
const related = getRelatedEntries(entry);
const productCategory = isProduct ? getProductCategory(entry) : null;
const productImages = [...new Set([entry.image, ...entry.images].filter(Boolean))];

const siteUrl = Astro.site?.toString() || "https://www.sharinglaundry.com";
function absoluteUrl(path: string) {
  return new URL(path, siteUrl).toString();
}

// JSON-LD schemas
const breadcrumbItems: Array<{ name: string; item: string }> = [{ name: "Home", item: absoluteUrl("/") }];
if (isProduct && productCategory) {
  breadcrumbItems.push({ name: productCategory.label, item: absoluteUrl(productCategory.href) });
  breadcrumbItems.push({ name: entry.title, item: absoluteUrl(entry.path) });
} else if (entry.kind === "post") {
  breadcrumbItems.push({ name: "News", item: absoluteUrl("/news/") });
  breadcrumbItems.push({ name: entry.title, item: absoluteUrl(entry.path) });
} else if (entry.path !== "/") {
  breadcrumbItems.push({ name: entry.title, item: absoluteUrl(entry.path) });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.item,
  })),
};

const schemas: Array<Record<string, unknown>> = [breadcrumbSchema];

if (isProduct) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Product",
    name: entry.title,
    image: productImages.map((img) => absoluteUrl(img)),
    description: entry.description,
    brand: {
      "@type": "Brand",
      name: "Wuxi Sharing Machinery Co.,Ltd",
    },
    url: absoluteUrl(entry.path),
  });
} else if (entry.kind === "post") {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: entry.title,
    description: entry.description,
    image: entry.image ? absoluteUrl(entry.image) : undefined,
    datePublished: entry.datePublished,
    dateModified: entry.dateModified || entry.datePublished,
    author: {
      "@type": "Organization",
      name: "Wuxi Sharing Machinery Co.,Ltd",
    },
    publisher: {
      "@type": "Organization",
      name: "Wuxi Sharing Machinery Co.,Ltd",
      logo: {
        "@type": "ImageObject",
        url: absoluteUrl("/wp-assets/uploads/250X100.png"),
      },
    },
    url: absoluteUrl(entry.path),
  });
}

// 为重复路径提供 canonical(主要路径)
const canonicalHref =
  entry.path.startsWith("/products/") && entry.path !== "/products/"
    ? entry.path.replace("/products/", "/product-category/") +
      (entry.path === "/products/" ? "" : "")
    : entry.path === "/shop/"
      ? "/products/"
      : null;
---

<MainLayout title={`${entry.title} - Wuxi Sharing Machinery Co.,Ltd`} description={entry.description} image={entry.image} canonical={canonicalHref || undefined} schemas={schemas}>
  {
    isProduct ? (
      <main class="pb-[60px]">
        {heroBg ? (
          <section class="relative overflow-hidden bg-cover bg-center bg-no-repeat py-[90px] text-white" style={`background-image: url('${heroBg}');`} data-reveal="fade">
            <div class="absolute inset-0 bg-[#0b1d33]/75"></div>
            <div class="pixel-container relative z-10">
              <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
              <div class="mt-[18px] h-[2px] w-[64px] bg-[var(--site-blue)]"></div>
              <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
                Focus on Industrial and Commercial Laundry Equipment over 15 years
              </p>
            </div>
          </section>
        ) : null}
        <nav class="pixel-container py-[18px] text-[14px] text-[#777]">
          <a href="/" class="hover:text-[var(--site-blue)]">Home</a>
          <span class="px-2">/</span>
          <a href={productCategory?.href} class="hover:text-[var(--site-blue)]">{productCategory?.label}</a>
          <span class="px-2">/</span>
          <span>{entry.title}</span>
        </nav>

        <section class="pixel-container grid gap-[48px] py-[28px] md:grid-cols-[520px_1fr]" data-reveal="fade-up">
          <div>
            <div class="border border-[#e5e5e5] bg-white p-[12px]">
              {entry.image ? (
                <img src={entry.image} alt={entry.title} class="aspect-square w-full object-cover" data-product-main-img />
              ) : (
                <div class="aspect-square bg-[#f1f1f1]" />
              )}
            </div>
            <div class="mt-[15px] flex gap-[12px]">
              {productImages.slice(0, 3).map((image, idx) => (
                <button type="button" class="h-[82px] w-[82px] border border-[#d5d5d5] p-[4px] transition hover:border-[var(--site-blue)] aria-pressed:border-[var(--site-blue)]" data-product-thumb={image} aria-pressed={idx === 0 ? "true" : "false"}>
                  <img src={image} alt={entry.title} class="h-full w-full object-cover" />
                </button>
              ))}
            </div>
          </div>

          <div class="pt-[10px]">
            <h2 class="text-[31px] font-normal leading-tight text-[var(--site-heading)]">{entry.title}</h2>
            <div class="my-[26px] h-px bg-[#e5e5e5]"></div>
            <p class="text-[15px] leading-[1.7] text-[#777]">{entry.description}</p>
            <div class="mt-[22px] text-[14px] text-[#777]">
              <span>Category: </span>
              <a href={productCategory?.href} class="text-[var(--site-blue)]">{productCategory?.label}</a>
            </div>
            <a href="/contact-us/" class="btn-primary mt-[30px]">Request an Offer</a>
          </div>
        </section>

        <section class="pixel-container pt-[28px]" data-reveal="fade-up" data-reveal-delay="100">
          <div class="border-b border-[#d3d3d3]" data-product-tabs>
            <button
              type="button"
              data-tab="description"
              class="product-tab border border-b-0 border-[#d3d3d3] bg-white px-[22px] py-[12px] text-[14px] font-bold text-[#333]"
            >
              Description
            </button>
            {entry.techTableHtml ? (
              <button
                type="button"
                data-tab="parameters"
                class="product-tab ml-[4px] border border-b-0 border-[#d3d3d3] bg-[#f7f7f7] px-[22px] py-[12px] text-[14px] text-[#777]"
              >
                Technical Parameters
              </button>
            ) : null}
          </div>
          <article
            data-tab-panel="description"
            class="content-prose border border-t-0 border-[#d3d3d3] px-[28px] py-[26px]"
            set:html={entry.contentHtml}
          />
          {entry.techTableHtml ? (
            <article
              data-tab-panel="parameters"
              class="content-prose hidden border border-t-0 border-[#d3d3d3] px-[28px] py-[26px]"
              set:html={entry.techTableHtml}
            />
          ) : null}
        </section>

        <section class="pixel-container pt-[54px]" data-reveal="fade-up">
          <h2 class="site-section-title mb-[26px]">Related products</h2>
          <div class="grid gap-[28px] sm:grid-cols-2 lg:grid-cols-4">
            {related.slice(0, 4).map((item) => (
              <a href={item.path} class="block text-center">
                <div class="aspect-square border border-[#e5e5e5] bg-[#f5f5f5]">
                  {item.image ? <img src={item.image} alt={item.title} class="h-full w-full object-cover" /> : null}
                </div>
                <h3 class="mt-[14px] text-[14px] font-bold text-[var(--site-blue-dark)]">{item.title}</h3>
              </a>
            ))}
          </div>
        </section>
      </main>
    ) : isContact ? (
      <main>
        <section class="relative overflow-hidden bg-[#0f2440] py-[110px] text-white" data-reveal="fade">
          {entry.image ? (
            <img src={entry.image} alt={entry.title} class="absolute inset-0 h-full w-full object-cover opacity-60" />
          ) : null}
          <div class="pixel-container relative">
            <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
            <div class="mt-[18px] h-[2px] w-[64px] bg-[var(--site-blue)]"></div>
            <p class="mt-[24px] max-w-[720px] text-[15px] leading-[1.7] text-white/85">
              We are committed to protecting your privacy and personal information collected through this contact form, and will not share, sell, or distribute it to third parties without your consent, except as required by law or necessary to fulfill your request.
            </p>
            <a href="#inquiry-form" class="btn-primary mt-[30px]">Send Inquiry</a>
          </div>
        </section>
        <section class="section-md pixel-container" data-reveal="fade-up">
          <h2 class="site-section-title">Contact Details</h2>
          <div class="content-prose mt-[34px]" set:html={entry.contentHtml}></div>
        </section>
        <section id="inquiry-form" class="section-md bg-[var(--site-gray-band)]" data-reveal="fade-up">
          <div class="pixel-container grid gap-[60px] md:grid-cols-[0.9fr_1fr]">
            <div class="text-white">
              <h2 class="site-section-title">Contact us</h2>
              <div class="mt-[34px] grid gap-[14px] text-[15px]">
                <p>No.588, Nanhu Avenue, Wuxi City, China</p>
                <p>+86-51066206136</p>
                <p>+86-13606196136</p>
                <p>info@sharinglaundry.com</p>
              </div>
            </div>
            <InquiryForm compact={true} />
          </div>
        </section>
      </main>
    ) : isAboutUs ? (
      <AboutUs entry={entry} />
    ) : isListing ? (
      <main class="bg-white">
        {heroBg ? (
          <section class="relative overflow-hidden bg-cover bg-center bg-no-repeat py-[90px] text-white" style={`background-image: url('${heroBg}');`} data-reveal="fade">
            <div class="absolute inset-0 bg-[#0b1d33]/75"></div>
            <div class="pixel-container relative z-10">
              <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
              <div class="mt-[18px] h-[2px] w-[64px] bg-[var(--site-blue)]"></div>
              {entry.path.startsWith("/products/") ? (
                <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
                  Focus on Industrial and Commercial Laundry Equipment over 15 years
                </p>
              ) : null}
            </div>
          </section>
        ) : null}
        <section class="section-md bg-[#f4f8fc]" data-reveal="fade-up">
          <div class="pixel-container">
            {listingProducts ? (
              <ProductGrid
                products={listingProducts}
              />
            ) : isNews ? (
              <>
                <div id="news-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                  {listingEntries.map((item, idx) => (
                    <div data-news-page={Math.floor(idx / 12) + 1} class:list={[idx >= 12 ? "hidden" : ""]}>
                      <EntryCard entry={item} />
                    </div>
                  ))}
                </div>
                {listingEntries.length > 12 ? (
                  <div id="news-pagination" class="mt-[40px] flex justify-center gap-[8px]"></div>
                ) : null}
              </>
            ) : (
              <EntryGrid
                title="Products"
                entries={listingEntries}
              />
            )}
          </div>
        </section>
      </main>
    ) : (
      <main>
        {heroBg ? (
          <section class="relative overflow-hidden bg-cover bg-center bg-no-repeat py-[90px] text-white" style={`background-image: url('${heroBg}');`} data-reveal="fade">
            <div class="absolute inset-0 bg-[#0b1d33]/75"></div>
            <div class="pixel-container relative z-10">
              <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
              <div class="mt-[18px] h-[2px] w-[64px] bg-[var(--site-blue)]"></div>
              {isSupport ? (
                <div class="mt-[20px] max-w-[640px]">
                  <p class="text-[22px] font-bold leading-snug text-white md:text-[26px]">We are here with you every step of the way</p>
                  <p class="mt-[14px] text-[16px] leading-[1.7] text-white/85">Sharing's customer service support including pre-sales and after-sales service support, made up by experienced technical staff, is able to assist every customer with detailed requirements or problems.</p>
                </div>
              ) : null}
              {isApplication ? (
                <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
                  Revolutionizing industrial and commercial laundry equipment applications
                </p>
              ) : null}
              {isAppSub ? (
                <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
                  Revolutionizing industrial and commercial laundry equipment applications
                </p>
              ) : null}
            </div>
          </section>
        ) : null}
        {!isApplication && !isAppSub ? (
        <section class="section-md pixel-container" data-reveal="fade-up">
          {!heroBg ? <h1 class="site-section-title">{entry.title}</h1> : null}
          {!isSupport && entry.datePublished ? <p class="mt-[22px] text-[14px] text-[#777]">{formatDate(entry.datePublished)}</p> : null}
          {!isSupport && entry.image && !entry.imageBoxCards?.length ? (
            <img src={entry.image} alt={entry.title} class="mt-[34px] max-h-[520px] w-full object-cover" />
          ) : null}
          <article class:list={["content-prose", !heroBg ? "mt-[34px]" : ""]}>
            {isSupport ? (
              <>
                <h2 class="text-[20px] font-bold text-[var(--site-blue-dark)]">Pre-Sales Service Support</h2>
                <p class="mt-[16px] text-[15px] leading-[1.7] text-[#777]">Sharing's Pre-sales service support department will work directly with you to determine your needs, knowing that the correct type and degree of agitation is a crucial factor in almost every processing operation.</p>
                <p class="mt-[14px] text-[15px] leading-[1.7] text-[#777]">These close customer relationships ensure that our products are manufactured to meet exact requirements for each specific application.</p>
                <p class="mt-[14px] text-[15px] leading-[1.7] text-[#777]">Engineering staff take into consideration the capacity, size and budgets, etc. Then they select from a vast range of options to provide the best choice in solutions for the application type and the size of the agitating unit required for the job.</p>

                <div class="mt-[30px] grid gap-[16px] sm:grid-cols-2">
                  <div class="overflow-hidden">
                    <img src="/wp-assets/uploads/img-support-01.jpeg" alt="Pre-sales service support" class="h-full w-full object-cover" loading="lazy" />
                  </div>
                  <div class="overflow-hidden">
                    <img src="/wp-assets/uploads/img-support-02.jpg" alt="Pre-sales consultation" class="h-full w-full object-cover" loading="lazy" />
                  </div>
                </div>

                <h2 class="mb-[16px] mt-[40px] text-[20px] font-bold text-[var(--site-blue-dark)]">After-Sales Service Support</h2>
                <p class="text-[15px] leading-[1.7] text-[#777]">Sharing's After-sales service support department will provide the following services:</p>
                <ol class="mt-[14px] list-decimal space-y-[10px] pl-[20px] text-[15px] leading-[1.7] text-[#777]">
                  <li>Spare parts for every piece of equipment with interchangeability guarantee and best delivery time.</li>
                  <li>Technical assistance or supervision on-site during the installation, maintenance, commissioning and start-up phases.</li>
                  <li>Customized maintenance programs (Periodic or as-required maintenance, during and after the warranty period).</li>
                  <li>Each service task is documented in our equipment records. This way the current condition and life cycle can always be displayed and analyzed. This service is free of charge for the owner of a Sharing's laundry equipment.</li>
                </ol>
              </>
            ) : (
              <div set:html={entry.fallbackContent || entry.contentHtml}></div>
            )}
          </article>
          {isRefund ? <a href="/contact-us/" class="btn-primary mt-[30px]">Contact Sales</a> : null}
        </section>
        ) : null}

        {isAppSub ? (
          <section class="section-md pixel-container" data-reveal="fade-up">
            <div class="grid gap-[48px] md:grid-cols-[1fr_1fr]">
              <div>
                {appImage ? (
                  <img src={appImage} alt={entry.title} class="w-full object-cover" loading="lazy" />
                ) : null}
              </div>
              <div>
                {appDescription ? (
                  <p class="text-[15px] leading-[1.7] text-[#777]" set:html={appDescription} />
                ) : null}
              </div>
            </div>
            <div class="mt-[48px] grid gap-[48px] md:grid-cols-[1fr_1fr]">
              {appSolutionsLeft ? (
                <div class="app-solutions" set:html={appSolutionsLeft} />
              ) : null}
              {appSolutionsRight ? (
                <div class="app-solutions" set:html={appSolutionsRight} />
              ) : null}
            </div>
          </section>
          <section class="section-md slanted-bg bg-white text-center" data-reveal="fade-up">
            <div class="pixel-container">
              <div class="text-[13px] font-bold uppercase tracking-[0.22em] text-[var(--site-blue)]">HOTLINE 24/7</div>
              <div class="mt-[16px] text-[28px] font-bold text-[var(--site-blue)]">+86-13606196136, 13861751289</div>
              <div class="mx-auto mt-[16px] h-[3px] w-[58px] bg-[var(--site-green)]"></div>
              <div class="mt-[24px] text-[14px] font-bold tracking-[0.22em] text-[var(--site-blue)]">Start Your Laundry Business Today</div>
              <a href="/contact-us/" class="btn-primary mt-[25px]">Contact Our Team <span>&gt;</span></a>
            </div>
          </section>
        ) : null}

        {isSupport ? (
          <section class="section-md slanted-bg bg-white text-center" data-reveal="fade-up">
            <div class="pixel-container">
              <div class="text-[13px] font-bold uppercase tracking-[0.22em] text-[var(--site-blue)]">HOTLINE 24/7</div>
              <div class="mt-[16px] text-[28px] font-bold text-[var(--site-blue)]">+86-13606196136, 13861751289</div>
              <div class="mx-auto mt-[16px] h-[3px] w-[58px] bg-[var(--site-green)]"></div>
              <div class="mt-[24px] text-[14px] font-bold tracking-[0.22em] text-[var(--site-blue)]">Start Your Laundry Business Today</div>
              <a href="/contact-us/" class="btn-primary mt-[25px]">Contact Our Team <span>&gt;</span></a>
            </div>
          </section>
        ) : null}
        {entry.imageBoxCards && entry.imageBoxCards.length > 0 ? (
          <section class="section-md bg-[#f4f8fc]" data-reveal="fade-up">
            <div class="pixel-container">
              <h2 class="site-section-title">Explore Our Applications</h2>
              <div class="mt-[42px] grid gap-[28px] sm:grid-cols-2 lg:grid-cols-3">
                {entry.imageBoxCards.map((card) => (
                  <a href={card.href} class="group block overflow-hidden bg-white shadow-sm transition hover:shadow-md">
                    <div class="aspect-[10/6.5] w-full overflow-hidden bg-[#f1f1f1]">
                      <img src={card.image} alt={card.title} class="h-full w-full object-cover transition group-hover:scale-105" loading="lazy" />
                    </div>
                    <div class="px-[22px] py-[18px]">
                      <h3 class="text-[18px] font-normal text-[var(--site-blue-dark)] group-hover:underline">{card.title}</h3>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        ) : null}
        {isApplication ? (
          <section class="section-md slanted-bg bg-white text-center" data-reveal="fade-up">
            <div class="pixel-container">
              <div class="text-[13px] font-bold uppercase tracking-[0.22em] text-[var(--site-blue)]">HOTLINE 24/7</div>
              <div class="mt-[16px] text-[28px] font-bold text-[var(--site-blue)]">+86-13606196136, 13861751289</div>
              <div class="mx-auto mt-[16px] h-[3px] w-[58px] bg-[var(--site-green)]"></div>
              <div class="mt-[24px] text-[14px] font-bold tracking-[0.22em] text-[var(--site-blue)]">Start Your Laundry Business Today</div>
              <a href="/contact-us/" class="btn-primary mt-[25px]">Contact Our Team <span>&gt;</span></a>
            </div>
          </section>
        ) : null}
      </main>
    )
  }
</MainLayout>

<script>
  // 产品页 Description / Technical Parameters 标签切换
  document.querySelectorAll<HTMLElement>("[data-product-tabs]").forEach((tabBar) => {
    const tabs = tabBar.querySelectorAll<HTMLButtonElement>(".product-tab");
    const panels = tabBar.parentElement?.querySelectorAll<HTMLElement>("[data-tab-panel]");
    if (!tabs.length || !panels?.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        // 切换按钮样式
        tabs.forEach((btn) => {
          const isActive = btn === tab;
          btn.classList.toggle("bg-white", isActive);
          btn.classList.toggle("font-bold", isActive);
          btn.classList.toggle("text-[#333]", isActive);
          btn.classList.toggle("bg-[#f7f7f7]", !isActive);
          btn.classList.toggle("text-[#777]", !isActive);
        });
        // 切换面板
        panels.forEach((panel) => {
          panel.classList.toggle("hidden", panel.dataset.tabPanel !== target);
        });
      });
    });
  });

  // 产品页缩略图切换主图
  document.querySelectorAll("[data-product-thumb]").forEach((thumb) => {
    thumb.addEventListener("click", () => {
      const mainImg = document.querySelector<HTMLImageElement>("[data-product-main-img]");
      if (!mainImg) return;
      mainImg.src = (thumb as HTMLElement).dataset.productThumb || mainImg.src;
      mainImg.parentElement?.querySelectorAll("[data-product-thumb]").forEach((btn) => {
        btn.setAttribute("aria-pressed", btn === thumb ? "true" : "false");
      });
    });
  });

  // News 页面分页（每页12条，4列×3行）
  (function() {
    const items = document.querySelectorAll<HTMLElement>("[data-news-page]");
    if (!items.length) return;
    const perPage = 12;
    const totalPages = Math.ceil(items.length / perPage);
    const pagination = document.getElementById("news-pagination");
    if (!pagination) return;

    function showPage(page: number) {
      items.forEach((el) => {
        el.classList.toggle("hidden", el.dataset.newsPage !== String(page));
      });
      pagination!.querySelectorAll("button").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.page === String(page);
        btn.classList.toggle("bg-[var(--site-blue)]", isActive);
        btn.classList.toggle("text-white", isActive);
        btn.classList.toggle("border-[var(--site-blue)]", isActive);
        btn.classList.toggle("border-[#d5d5d5]", !isActive);
        btn.classList.toggle("text-[#777]", !isActive);
      });
    }

    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement("button");
      btn.textContent = String(i);
      btn.dataset.page = String(i);
      btn.className = "h-[38px] w-[38px] border text-[14px] transition hover:border-[var(--site-blue)]";
      if (i === 1) {
        btn.classList.add("bg-[var(--site-blue)]", "text-white", "border-[var(--site-blue)]");
      } else {
        btn.classList.add("border-[#d5d5d5]", "text-[#777]");
      }
      btn.addEventListener("click", () => showPage(i));
      pagination.appendChild(btn);
    }
  })();
</script>
