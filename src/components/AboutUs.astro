---
import type { SiteEntry } from "../types/content";

const { entry } = Astro.props as { entry: SiteEntry };

const galleryImages = [
  "/wp-assets/uploads/Company-Profile-1.jpg",
  "/wp-assets/uploads/Company-Profile-2.jpg",
  "/wp-assets/uploads/Company-Profile-3.jpg",
  "/wp-assets/uploads/Company-Profile-4.jpg",
  "/wp-assets/uploads/Company-Profile-5.jpg",
  "/wp-assets/uploads/Company-Profile-6.jpg",
];
const certificateImages = [
  "/wp-assets/uploads/cer-1.jpg",
  "/wp-assets/uploads/cert-3.jpg",
  "/wp-assets/uploads/cer-2.jpg",
];

const whyChooseItems = [
  { title: "Expert Engineers", icon: "engineer" },
  { title: "Experience Skills", icon: "skills" },
  { title: "Affordable Costs", icon: "cost" },
  { title: "Guarantee Services", icon: "guarantee" },
  { title: "Trusted Work", icon: "trust" },
  { title: "After Sale Service", icon: "service" },
];

const cultureItems = [
  {
    title: "Our Mission",
    body: "To become the preferred supplier and first call for our customers, recognized for delivering innovative solutions and inspiration through our laundry equipment, service and relationships. To conduct business through trust, professionalism and innovation, based on our organization's ideals, values and philosophies, which we strive to achieve through the below.",
  },
  {
    title: "Responsibility",
    body: "We care about our staff, we aim to provide an enjoyable, healthy and safe environment for all team members. Our priority is to build strong and trusted relationships with customers and suppliers based on ethical business practices and deliver on our promises. We strive to protect our fragile environment by conducting the best practices in all areas of our business.",
  },
  {
    title: "Innovation",
    body: "Innovation is vitally important for our business. It is at the center of who we are and what we do. Through innovation, we will continue to find efficient business solutions and better manufacturing methods for our customers.",
  },
  {
    title: "Excellence",
    body: "We are committed to achieving shared goals based on open and honest communication. We enjoy what we do, we take pride in our job, products and vision. We constantly seek to meet and exceed the highest expectations of our employees, customers and suppliers by establishing and communicating clear expectations.",
  },
  {
    title: "Integrity",
    body: "We are focused on achieving the advantage of honest and loyal actions, as individuals and as an organization, without compromise. We strive to uphold the highest professional standards, thereby earning and maintaining the trust and respect of all company stakeholders.",
  },
];

// SVG icons matching original site semantics (stroke-based, 24x24 viewBox)
const iconSvg: Record<string, string> = {
  engineer: `
    <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <path d="M6 21v-1a6 6 0 0112 0v1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M16 4l2-2M18 4l-2-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  `,
  skills: `
    <path d="M14.7 6.3a4 4 0 10-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 005.4-5.4l-2.8 2.8-2.2-2.2 2.8-2.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  cost: `
    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  guarantee: `
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  trust: `
    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  service: `
    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.13.81.36 1.6.68 2.34a2 2 0 01-.45 2.11L8.09 9.41a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.74.32 1.53.55 2.34.68a2 2 0 011.72 2.03z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  `,
};
---

<main>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-cover bg-center bg-no-repeat py-[90px] text-white" style="background-image: url('/wp-assets/uploads/img-bg-laundry.jpg');" data-reveal="fade">
    <div class="absolute inset-0 bg-bg-hero-overlay"></div>
    <div class="pixel-container relative z-10">
      <h1 class="text-[40px] font-normal leading-tight md:text-[48px]">{entry.title}</h1>
      <div class="mt-[18px] h-[2px] w-[64px] bg-brand-primary"></div>
      <p class="mt-[20px] max-w-[640px] text-[18px] font-bold leading-[1.5] text-white">
        Focus on Industrial and Commercial Laundry Equipment over 15 years
      </p>
    </div>
  </section>

  <!-- Company Profile -->
  <section class="section-lg" data-reveal="fade-up">
    <div class="pixel-container">
      <div class="text-center">
        <h2 class="site-section-title mx-auto inline-block">Company Profile</h2>
      </div>

      <div class="mt-[60px] grid gap-[50px] md:grid-cols-[1fr_1.1fr]">
        <div>
          <h3 class="text-[20px] font-bold text-brand-primary-hover">Brief Introduction</h3>
          <div class="mt-[20px] space-y-[16px] text-[15px] leading-[1.7] text-neutral-600">
            <p>Wuxi Sharing Machinery Co., Ltd located in East China, 100km away from Shanghai, specializes in manufacturing and selling China's best quality commercial and industrial laundry equipment, including washer extractors, tumble dryers, flatwork ironers, folders, dry cleaning machines, laundry press machine, and finishing equipment, etc.</p>
            <p>We are acknowledged as a leading supplier in the field of industrial and commercial laundry equipment in China now. In the past 15 years, We have established long-term and mutually beneficial relationships with our customers at home and abroad.</p>
            <p>Sharing's laundry equipment is popular with customers at home and abroad, we always commit to continuing innovation &amp; improvement, providing high-quality machines, professional &amp; sincere service and competitive prices.</p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-[14px]">
          {galleryImages.map((src, idx) => (
            <div class="aspect-[1.35/1] overflow-hidden bg-neutral-160">
              <img
                src={src}
                alt={`Company profile ${idx + 1}`}
                class="h-full w-full object-cover transition duration-500 hover:scale-105"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section-lg bg-white" data-reveal="fade-up">
    <div class="pixel-container">
      <div class="text-center">
        <h2 class="site-section-title mx-auto inline-block">Why Choose Us</h2>
      </div>

      <div class="mx-auto mt-[70px] grid max-w-[860px] grid-cols-1 gap-x-[60px] gap-y-[42px] sm:grid-cols-2 md:grid-cols-3">
        {whyChooseItems.map((item) => (
          <div class="flex flex-col items-center text-center">
            <div class="flex h-[80px] w-[80px] items-center justify-center rounded-full border border-neutral-350 text-brand-primary">
              <svg class="h-[36px] w-[36px]" viewBox="0 0 24 24" aria-hidden="true" set:html={iconSvg[item.icon]} />
            </div>
            <h3 class="mt-[18px] text-[16px] font-semibold text-neutral-950">{item.title}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Company Culture -->
  <section class="section-lg bg-white" data-reveal="fade-up">
    <div class="pixel-container">
      <div class="text-center">
        <h2 class="site-section-title mx-auto inline-block">Company Culture</h2>
      </div>

      <div class="mx-auto mt-[60px] max-w-[860px] space-y-[34px]">
        {cultureItems.map((item) => (
          <div>
            <h3 class="text-[18px] font-bold text-brand-primary">{item.title}</h3>
            <p class="mt-[12px] text-[15px] leading-[1.75] text-neutral-600">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certificates -->
  <section class="section-lg bg-white" data-reveal="fade-up">
    <div class="pixel-container">
      <div class="text-center">
        <h2 class="site-section-title mx-auto inline-block">Certificates</h2>
      </div>

      <div class="mx-auto mt-[60px] grid max-w-[1080px] grid-cols-1 gap-[28px] sm:grid-cols-2 md:grid-cols-3">
        {certificateImages.map((src) => (
          <div class="overflow-hidden bg-white shadow-[0_8px_24px_rgba(0,0,0,0.08)]">
            <img src={src} alt="Certificate" class="aspect-[3/4] w-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hotline CTA -->
  <section class="relative overflow-hidden bg-neutral-220 py-[80px] text-center" data-reveal="fade-up">
    <div class="absolute inset-y-0 right-0 hidden w-1/2 bg-neutral-310 md:block" style="clip-path: polygon(20% 0, 100% 0, 100% 100%, 0 100%);"></div>
    <div class="pixel-container relative">
      <p class="text-[14px] font-semibold tracking-[0.18em] text-brand-primary">HOTLINE 24/7</p>
      <h2 class="mt-[14px] text-[28px] font-bold text-brand-primary md:text-[32px]">+86-13606196136, 13861751289</h2>
      <div class="mx-auto mt-[24px] h-[2px] w-[60px] bg-brand-secondary"></div>
      <p class="mt-[34px] text-[15px] font-semibold tracking-[0.12em] text-brand-primary">Start Your Laundry Business Today</p>
      <div class="mt-[24px]">
        <a href="/contact-us/" class="btn-primary">Contact Our Team</a>
      </div>
    </div>
  </section>
</main>
