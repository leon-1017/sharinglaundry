  </div>
  <div class="pixel-container flex flex-col gap-3 border-t border-neutral-550/50 pb-9 pt-6 text-xs text-neutral-600 md:flex-row md:items-center md:justify-between">
    <div>Copyright © 2026 Wuxi Sharing Machinery Co.,Ltd</div>
    <div class="flex gap-2">
      <a href="https://www.facebook.com/profile.php?id=100011834623780" class="flex h-5 w-5 items-center justify-center bg-facebook text-[10px] font-bold text-white">f</a>
      <a href="https://www.linkedin.com/in/mark-jia-364601b8?trk=nav_responsive_tab_profile_pic" class="flex h-5 w-5 items-center justify-center bg-linkedin text-[10px] font-bold text-white">in</a>
    </div>
