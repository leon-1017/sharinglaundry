---
import { productCategories } from "../data/navigation";
---

<footer class="footer-metallic text-neutral-800">
  <div class="pixel-container grid gap-12 py-[58px] md:grid-cols-[280px_260px_1fr]">
    <div>
      <a href="/" class="block w-[220px] max-w-full">
        <img src="/wp-assets/uploads/250X100.png" alt="Wuxi Sharing Machinery Co.,Ltd" class="h-auto w-full" />
      </a>
    </div>

    <div>
      <h3 class="mb-5 text-[22px] font-bold text-brand-primary">Products</h3>
      <nav class="grid gap-[13px]">
        {productCategories.map((item) => (
          <a href={item.href} class="text-xs font-semibold uppercase text-neutral-600 hover:text-brand-primary">{item.label}</a>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="mb-5 text-[22px] font-bold text-brand-primary">Contact us</h3>
      <div class="grid gap-[11px] text-sm">
        <p>No.588, Nanhu Avenue, Wuxi City, China</p>
        <p>+86-51066206136</p>
        <p>+86-13606196136</p>
        <p>info@sharinglaundry.com</p>
        <a href="https://wa.me/+8613606196136" class="mt-1 inline-flex w-fit items-center gap-2 rounded-[3px] bg-whatsapp px-5 py-[7px] text-xs font-bold text-white">
