---
import type { SiteEntry } from "../types/content";

const { entry, eyebrow } = Astro.props as { entry: SiteEntry; eyebrow?: string };
---

<a href={entry.path} class="card-link group overflow-hidden">
  {
    entry.image ? (
      <div class="aspect-[4/3] overflow-hidden bg-neutral-140">
        <img src={entry.image} alt={entry.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
      </div>
    ) : null
  }
  <div class="space-y-[10px] p-[18px]">
    {eyebrow ? <div class="text-xs font-semibold uppercase text-brand-primary">{eyebrow}</div> : null}
    <h3 class="text-[17px] font-bold leading-tight text-brand-primary-hover">{entry.title}</h3>
    <p class="text-sm leading-[1.6] text-neutral-600">{entry.description}</p>
    <span class="inline-flex text-xs font-bold text-brand-primary">View details</span>
  </div>
</a>
