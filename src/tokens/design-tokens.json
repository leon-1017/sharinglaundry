      "$value": {
        "x": "0",
        "y": "10px",
        "blur": "24px",
        "spread": "0",
        "color": "rgba(11,74,143,0.16)"
      },
      "$type": "shadow",
      "$description": "Primary button hover shadow"
    }
  },
